{
  "name": "rektangel",
  "version": "0.1.0",
  "private": true,
  "description": "Keyboard window management for Linux desktops, ported from Rectangle",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "core",
    "gnome"
  ],
  "scripts": {
    "build": "npm run build --workspace core --workspace gnome",
    "test": "npm test --workspace core --workspace gnome",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "pack": "gnome/pack.sh",
    "reload": "gnome/reload.sh",
    "prefs": "gnome/prefs-dev.sh",
    "prefs-sandbox": "gnome/prefs-dev.sh --sandbox"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript-eslint": "8.74.0"
  }
}
