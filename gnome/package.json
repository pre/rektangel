{
  "name": "@rektangel/gnome",
  "version": "0.1.0",
  "private": true,
  "description": "Rektangel GNOME Shell extension",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && node esbuild.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test \"test/**/*.test.ts\" && test/gnome-keys-normalize.sh && node esbuild.mjs && XDG_CONFIG_HOME=test/fixtures/config gjs -m test/gjs-smoke.js && gjs -m test/gjs-capslock.js",
    "pack": "./pack.sh",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" \"test/**/*.test.ts\"",
    "test:xkb": "test/xkb-check.sh",
    "prefs": "./prefs-dev.sh",
    "prefs-sandbox": "./prefs-dev.sh --sandbox"
  },
  "dependencies": {
    "@rektangel/core": "0.1.0"
  },
  "devDependencies": {
    "@girs/gjs": "4.0.0-beta.12",
    "@girs/gnome-shell": "46.0.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "@types/node": "22.20.5"
  }
}
