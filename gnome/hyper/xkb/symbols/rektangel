// Rektangel Caps Lock mode.
//
// Caps Lock held is Hyper_L on Mod3, so that <Hyper> shortcuts do not
// collide with <Super> (Mod4). Shift+Caps Lock toggles caps lock.

partial modifier_keys
xkb_symbols "caps_hyper" {
    key <CAPS> { type[Group1] = "TWO_LEVEL", [ Hyper_L, Caps_Lock ] };
    modifier_map Mod3 { <CAPS> };
};
